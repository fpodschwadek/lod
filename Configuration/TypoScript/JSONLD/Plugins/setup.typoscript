# Template paths for the jsonld representation. Registered unconditionally: every format tree holds
# only files carrying its own extension (Api/About.jsonld and so on), so Fluid resolves the right
# template from the Extbase request format alone and no page type condition is needed.
plugin.tx_lod.view {
  layoutRootPaths.11 = EXT:lod/Resources/Private/JSONLD/Layouts/
  partialRootPaths.11 = EXT:lod/Resources/Private/JSONLD/Partials/
  templateRootPaths.11 = EXT:lod/Resources/Private/JSONLD/Templates/
}
