jsonld = PAGE
jsonld {

  typeNum = 2014

  config {
    disableAllHeaderCode = 1
    additionalHeaders {
      10.header = Content-type:application/ld+json
    }
    admPanel = 0
    xhtml_cleaning = 0
    disablePrefixComment = 1
    debug = 0
  }
}

# Rendering the plugin is not guarded by a page type condition: only the PAGE object whose
# typeNum matches the current request is ever rendered, so the condition never bought anything.
# It used to read "getTSFE().type", which silently evaluates to null since TYPO3 v13 removed the
# $type property from TypoScriptFrontendController, leaving every serialisation blank.
jsonld.10 < lib.tx_lod.plugin

# Representation offered by this page type, used by \Digicademy\Lod\Service\ContentNegotiationService.
plugin.tx_lod.settings.contentNegotiation {
  # the Hydra spec requires the API documentation to be JSON-LD
  apiDocumentationPageType = 2014
  types.2014 {
    mimeType = application/ld+json
    format = jsonld
  }
}
