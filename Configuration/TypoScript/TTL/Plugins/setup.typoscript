# Template paths for the ttl representation. Registered unconditionally: every format tree holds
# only files carrying its own extension (Api/About.ttl and so on), so Fluid resolves the right
# template from the Extbase request format alone and no page type condition is needed.
plugin.tx_lod.view {
  layoutRootPaths.14 = EXT:lod/Resources/Private/TTL/Layouts/
  partialRootPaths.14 = EXT:lod/Resources/Private/TTL/Partials/
  templateRootPaths.14 = EXT:lod/Resources/Private/TTL/Templates/
}
