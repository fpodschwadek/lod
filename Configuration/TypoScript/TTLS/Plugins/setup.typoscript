# Template paths for the ttls representation. Registered unconditionally: every format tree holds
# only files carrying its own extension (Api/About.ttls and so on), so Fluid resolves the right
# template from the Extbase request format alone and no page type condition is needed.
plugin.tx_lod.view {
  layoutRootPaths.15 = EXT:lod/Resources/Private/TTLS/Layouts/
  partialRootPaths.15 = EXT:lod/Resources/Private/TTLS/Partials/
  templateRootPaths.15 = EXT:lod/Resources/Private/TTLS/Templates/
}
