# Template paths for the html representation. Registered unconditionally: every format tree holds
# only files carrying its own extension (Api/About.html and so on), so Fluid resolves the right
# template from the Extbase request format alone and no page type condition is needed.
plugin.tx_lod.view {
  layoutRootPaths.10 = EXT:lod/Resources/Private/HTML/Layouts/
  partialRootPaths.10 = EXT:lod/Resources/Private/HTML/Partials/
  templateRootPaths.10 = EXT:lod/Resources/Private/HTML/Templates/
}
